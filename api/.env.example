# Contrato de configuración local; documenta variables esperadas sin contener secretos reales.

# Aplicación
NODE_ENV=development
PORT=3000
APP_TIME_ZONE=America/Argentina/Cordoba
TRUST_PROXY=false

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/centro_interdisciplinario
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/centro_interdisciplinario_test
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_POOL_IDLE_MS=10000
DB_POOL_ACQUIRE_MS=30000
DB_SSL=false

# Access token
JWT_ACCESS_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_ISSUER=centro-interdisciplinario-api
JWT_AUDIENCE=centro-interdisciplinario-client
ACCESS_TOKEN_TTL=15m

# Refresh y credenciales
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_NAME=refreshToken
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
BCRYPT_ROUNDS=12

# HTTP y seguridad
CORS_ORIGINS=http://localhost:5173
JSON_BODY_LIMIT=1mb
GLOBAL_RATE_LIMIT_WINDOW_MS=900000
GLOBAL_RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30

# Logging y archivos
LOG_LEVEL=info
UPLOAD_ROOT=uploads
UPLOAD_MAX_BYTES=5242880

# Solo para npm run create-admin o node scripts/create-admin.js
ADMIN_NOMBRE=
ADMIN_APELLIDO=
ADMIN_DNI=
ADMIN_EMAIL=
